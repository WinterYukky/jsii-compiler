         assert.ok(!doc.includes("@param"), "Documentation comment should not include tags");
     });
 
+    test("getSymbolDocumentations returns, per symbol, what the individual calls return", async () => {
+        await using api = spawnAPI(docFiles);
+
+        const snapshot = await api.createSnapshot({ openProjects: ["/tsconfig.json"] });
+        const project = snapshot.getConfiguredProject("/tsconfig.json")!;
+        const checker = project.checker;
+        const addSymbol = await checker.getSymbolAtPosition("/src/main.ts", docFiles["/src/main.ts"].indexOf("add(a"));
+        assert.ok(addSymbol);
+        const paramSymbol = await checker.getSymbolAtPosition("/src/main.ts", docFiles["/src/main.ts"].indexOf("a: number"));
+        assert.ok(paramSymbol);
+        const symbols = [addSymbol, paramSymbol, addSymbol];
+        const batched = await checker.getSymbolDocumentations(symbols);
+        assert.equal(batched.length, symbols.length);
+        for (let i = 0; i < symbols.length; i++) {
+            assert.deepEqual(batched[i].tags, await checker.getJsDocTagsOfSymbol(symbols[i]));
+            assert.equal(batched[i].comment, await checker.getDocumentationCommentOfSymbol(symbols[i]));
+        }
+        assert.ok(batched[0].comment.includes("Adds two numbers together"));
+        assert.deepEqual(await checker.getSymbolDocumentations([]), []);
+    });
+
