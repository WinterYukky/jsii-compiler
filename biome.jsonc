// biome-ignore-all format: ~~ Generated by projen. To modify, edit .projenrc.ts and run "yarn projen".
{
  "assist": {
    "actions": {
      "preset": "recommended"
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**",
      "test/**",
      "build-tools/**",
      "projenrc/**",
      ".projenrc.ts",
      "!test/negatives",
      "!**/*.generated.ts",
      "!test/**/__snapshots__",
      "!**/*.md",
      "!.backportrc.json",
      "!.gitattributes",
      "!.github/workflows/auto-approve.yml",
      "!.github/workflows/auto-merge.yml",
      "!.github/workflows/auto-tag-dev-v5.9.yml",
      "!.github/workflows/auto-tag-dev-v7.1.yml",
      "!.github/workflows/auto-tag-dev.yml",
      "!.github/workflows/auto-tag-releases-v5.9.yml",
      "!.github/workflows/auto-tag-releases.yml",
      "!.github/workflows/backport.yml",
      "!.github/workflows/build.yml",
      "!.github/workflows/pull-request-lint.yml",
      "!.github/workflows/release.yml",
      "!.github/workflows/upgrade-main.yml",
      "!.github/workflows/upgrade-maintenance-v5.9.yml",
      "!.github/workflows/upgrade-preview-v7.1.yml",
      "!.gitignore",
      "!.npmignore",
      "!.projen/deps.json",
      "!.projen/files.json",
      "!.projen/tasks.json",
      "!.vscode/extensions.json",
      "!.vscode/settings.json",
      "!jest.config.json",
      "!projenrc/tsconfig.json",
      "!releases.json",
      "!test/tsconfig.json",
      "!tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "bracketSpacing": true,
      "quoteProperties": "preserve",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "useLiteralKeys": "error",
        "noForEach": "error",
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off",
        "noThisInStatic": "off",
        "noUselessContinue": "off",
        "noUselessSwitchCase": "off",
        "noUselessTernary": "off",
        "noUselessTypeConstraint": "off",
        "useArrowFunction": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUndeclaredDependencies": {
          "level": "error",
          "options": {
            "devDependencies": [
              "**/test/**",
              "**/build-tools/**",
              "**/projenrc/**",
              ".projenrc.ts"
            ],
            "optionalDependencies": false,
            "peerDependencies": true
          }
        },
        "noSwitchDeclarations": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "preset": "recommended",
      "style": {
        "noCommonJs": "error",
        "useNodejsImportProtocol": "error",
        "useBlockStatements": "off",
        "noNonNullAssertion": "off",
        "useArrayLiterals": "off",
        "useConst": "off",
        "useImportType": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noShadow": "off",
        "noConstEnum": "off",
        "noDoubleEquals": "off",
        "noExplicitAny": "off",
        "noGlobalIsNan": "off",
        "noIdenticalTestTitle": "off",
        "noImplicitAnyLet": "off",
        "noShadowRestrictedNames": "off",
        "noTemplateCurlyInString": "off"
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "overrides": [
    {
      "includes": [
        ".projenrc.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          },
          "style": {
            "noCommonJs": "off"
          }
        }
      }
    }
  ]
}
